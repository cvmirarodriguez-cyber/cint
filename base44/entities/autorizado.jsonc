// Correos invitados como jefe de obra: quedan aprobados solos al crear su cuenta.
{
  "name": "Autorizado",
  "type": "object",
  "properties": {
    "email": { "type": "string", "format": "email", "description": "Correo invitado, en minúsculas" },
    "invitado_por": { "type": "string" }
  },
  "required": ["email"],
  "rls": {
    "read": { "user_condition": { "role": "admin" } },
    "create": { "user_condition": { "role": "admin" } },
    "update": { "user_condition": { "role": "admin" } },
    "delete": { "user_condition": { "role": "admin" } }
  }
}
