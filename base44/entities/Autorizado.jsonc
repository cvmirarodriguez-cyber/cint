{
  "type": "object",
  "name": "Autorizado",
  "properties": {
    "email": {
      "type": "string",
      "description": "Correo invitado, en min\u00fasculas",
      "format": "email"
    },
    "invitado_por": {
      "type": "string"
    },
    "perfil": {
      "type": "string",
      "enum": [
        "gerente_rrhh",
        "gerente_general",
        "jefe_personal",
        "jefe_obra"
      ],
      "enumNames": [
        "Gerente de RRHH",
        "Gerente general",
        "Jefe de personal de obra",
        "Jefe de terreno"
      ],
      "default": "jefe_obra",
      "description": "Perfil con el que fue invitado"
    }
  },
  "required": [
    "email"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "$or": [
        {
          "$and": [
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "$or": [
                {
                  "user_condition": {
                    "data.perfil": "gerente_rrhh"
                  }
                },
                {
                  "user_condition": {
                    "data.perfil": "gerente_general"
                  }
                },
                {
                  "user_condition": {
                    "data.perfil": "soporte"
                  }
                }
              ]
            }
          ]
        },
        {
          "$and": [
            {
              "$and": [
                {
                  "user_condition": {
                    "role": "admin"
                  }
                },
                {
                  "user_condition": {
                    "data.perfil": "jefe_personal"
                  }
                }
              ]
            },
            {
              "data.perfil": "jefe_obra"
            }
          ]
        }
      ]
    },
    "update": {
      "$and": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "$or": [
            {
              "user_condition": {
                "data.perfil": "gerente_rrhh"
              }
            },
            {
              "user_condition": {
                "data.perfil": "gerente_general"
              }
            },
            {
              "user_condition": {
                "data.perfil": "soporte"
              }
            }
          ]
        }
      ]
    },
    "delete": {
      "$and": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "$or": [
            {
              "user_condition": {
                "data.perfil": "gerente_rrhh"
              }
            },
            {
              "user_condition": {
                "data.perfil": "gerente_general"
              }
            },
            {
              "user_condition": {
                "data.perfil": "soporte"
              }
            }
          ]
        }
      ]
    }
  }
}