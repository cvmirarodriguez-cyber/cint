{
  "type": "object",
  "name": "Autorizado",
  "properties": {
    "email": {
      "type": "string",
      "description": "Correo invitado, en min\u00fasculas",
      "format": "email"
    },
    "invitado_por": {
      "type": "string"
    },
    "perfil": {
      "type": "string",
      "enum": [
        "gerente_rrhh",
        "jefe_personal",
        "jefe_obra"
      ],
      "enumNames": [
        "Gerente de RRHH",
        "Jefe de personal",
        "Jefe de obra"
      ],
      "default": "jefe_obra",
      "description": "Perfil con el que fue invitado"
    }
  },
  "required": [
    "email"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}