// Usuario de la app. "acceso" lo aprueba el jefe de personal: sin él, una cuenta
// registrada por su cuenta no ve ningún dato (la app es pública).
{
  "name": "User",
  "type": "object",
  "properties": {
    "acceso": {
      "type": "boolean",
      "default": false,
      "description": "Aprobado por el jefe de personal para ver y registrar evaluaciones",
      "rls": { "write": { "user_condition": { "role": "admin" } } }
    }
  }
}
