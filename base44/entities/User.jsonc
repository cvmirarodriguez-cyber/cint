{
  "type": "object",
  "name": "User",
  "properties": {
    "acceso": {
      "type": "boolean",
      "description": "Aprobado por el jefe de personal de obra para ver y registrar evaluaciones",
      "default": false,
      "rls": {
        "write": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
    "perfil": {
      "type": "string",
      "enum": [
        "gerente_rrhh",
        "jefe_personal",
        "jefe_obra"
      ],
      "enumNames": [
        "Gerente de RRHH",
        "Jefe de personal de obra",
        "Jefe de obra"
      ],
      "description": "Cargo dentro de la app; los dos primeros tienen acceso total",
      "rls": {
        "write": {
          "$and": [
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "$nor": [
                {
                  "user_condition": {
                    "data.perfil": "jefe_personal"
                  }
                }
              ]
            }
          ]
        }
      }
    }
  },
  "required": []
}