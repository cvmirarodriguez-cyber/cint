{
  "type": "object",
  "name": "Trabajador",
  "properties": {
    "demo": {
      "type": "boolean",
      "description": "Dato de demostraci\u00f3n; se borra desde Importar",
      "default": false
    },
    "nombre": {
      "type": "string",
      "description": "Nombre completo"
    },
    "rut": {
      "type": "string",
      "description": "RUT normalizado sin puntos, con gui\u00f3n (ej: 12345678-9)"
    },
    "cargo": {
      "type": "string",
      "enum": [
        "supervisor",
        "capataz",
        "maestro_primera",
        "maestro_segunda",
        "jornal"
      ],
      "enumNames": [
        "Supervisor de terreno",
        "Capataz",
        "Maestro primera",
        "Maestro segunda",
        "Jornal"
      ],
      "default": "jornal"
    },
    "especialidad": {
      "type": "string",
      "description": "Especialidad (enfierradura, carpinter\u00eda, alba\u00f1iler\u00eda, etc.)"
    },
    "telefono": {
      "type": "string"
    },
    "notas": {
      "type": "string",
      "maxLength": 1000
    },
    "experiencia": {
      "type": "string",
      "maxLength": 2000,
      "description": "Resumen de experiencia (sacado del curr\u00edculum)"
    },
    "documentos": {
      "type": "array",
      "description": "Curr\u00edculums y documentos del trabajador (archivos privados)",
      "items": {
        "type": "object",
        "properties": {
          "nombre": {
            "type": "string"
          },
          "uri": {
            "type": "string",
            "description": "Archivo privado; se abre con enlace temporal"
          },
          "tipo": {
            "type": "string",
            "enum": [
              "cv",
              "otro"
            ]
          },
          "fecha": {
            "type": "string",
            "format": "date-time"
          },
          "subido_por": {
            "type": "string"
          }
        }
      }
    }
  },
  "required": [
    "nombre",
    "rut"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "$and": [
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "$or": [
                {
                  "user_condition": {
                    "data.perfil": "gerente_rrhh"
                  }
                },
                {
                  "user_condition": {
                    "data.perfil": "soporte"
                  }
                }
              ]
            }
          ]
        },
        {
          "$and": [
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "user_condition": {
                "data.perfil": "jefe_personal"
              }
            }
          ]
        }
      ]
    },
    "create": {
      "$or": [
        {
          "$and": [
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "$or": [
                {
                  "user_condition": {
                    "data.perfil": "gerente_rrhh"
                  }
                },
                {
                  "user_condition": {
                    "data.perfil": "soporte"
                  }
                }
              ]
            }
          ]
        },
        {
          "$and": [
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "user_condition": {
                "data.perfil": "jefe_personal"
              }
            }
          ]
        }
      ]
    },
    "update": {
      "$or": [
        {
          "$and": [
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "$or": [
                {
                  "user_condition": {
                    "data.perfil": "gerente_rrhh"
                  }
                },
                {
                  "user_condition": {
                    "data.perfil": "soporte"
                  }
                }
              ]
            }
          ]
        },
        {
          "$and": [
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "user_condition": {
                "data.perfil": "jefe_personal"
              }
            }
          ]
        }
      ]
    },
    "delete": {
      "$and": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "$or": [
            {
              "user_condition": {
                "data.perfil": "gerente_rrhh"
              }
            },
            {
              "user_condition": {
                "data.perfil": "soporte"
              }
            }
          ]
        }
      ]
    }
  }
}