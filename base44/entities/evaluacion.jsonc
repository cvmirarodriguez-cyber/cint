{
  "type": "object",
  "name": "Evaluacion",
  "properties": {
    "demo": {
      "type": "boolean",
      "description": "Dato de demostraci\u00f3n; se borra desde Importar",
      "default": false
    },
    "trabajador_id": {
      "type": "string"
    },
    "trabajador_nombre": {
      "type": "string"
    },
    "trabajador_rut": {
      "type": "string"
    },
    "cargo": {
      "type": "string"
    },
    "obra_id": {
      "type": "string"
    },
    "obra_nombre": {
      "type": "string"
    },
    "contrato_id": {
      "type": "string"
    },
    "fecha_termino": {
      "type": "string",
      "format": "date"
    },
    "desempeno": {
      "type": "integer",
      "description": "Calidad y rendimiento del trabajo",
      "minimum": 1,
      "maximum": 5
    },
    "responsabilidad": {
      "type": "integer",
      "description": "Puntualidad, asistencia, compromiso",
      "minimum": 1,
      "maximum": 5
    },
    "alcohol_drogas": {
      "type": "string",
      "enum": [
        "sin_observaciones",
        "sospecha",
        "confirmado"
      ],
      "enumNames": [
        "Sin observaciones",
        "Sospecha / reporte",
        "Incidente confirmado"
      ],
      "default": "sin_observaciones"
    },
    "recontratar": {
      "type": "string",
      "enum": [
        "si",
        "con_reservas",
        "no"
      ],
      "enumNames": [
        "S\u00ed",
        "Con reservas",
        "No"
      ],
      "default": "si"
    },
    "comentario": {
      "type": "string",
      "maxLength": 500
    },
    "evaluador_nombre": {
      "type": "string"
    }
  },
  "required": [
    "trabajador_id",
    "desempeno",
    "responsabilidad"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "$and": [
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "$or": [
                {
                  "user_condition": {
                    "data.perfil": "gerente_rrhh"
                  }
                },
                {
                  "user_condition": {
                    "data.perfil": "gerente_general"
                  }
                },
                {
                  "user_condition": {
                    "data.perfil": "soporte"
                  }
                }
              ]
            }
          ]
        },
        {
          "$and": [
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "user_condition": {
                "data.perfil": "jefe_personal"
              }
            }
          ]
        },
        {
          "$and": [
            {
              "user_condition": {
                "data.acceso": true
              }
            },
            {
              "created_by": "{{user.email}}"
            }
          ]
        }
      ]
    },
    "create": {
      "$or": [
        {
          "$and": [
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "$or": [
                {
                  "user_condition": {
                    "data.perfil": "gerente_rrhh"
                  }
                },
                {
                  "user_condition": {
                    "data.perfil": "gerente_general"
                  }
                },
                {
                  "user_condition": {
                    "data.perfil": "soporte"
                  }
                }
              ]
            }
          ]
        },
        {
          "$and": [
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "user_condition": {
                "data.perfil": "jefe_personal"
              }
            }
          ]
        },
        {
          "user_condition": {
            "data.acceso": true
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "$and": [
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "$or": [
                {
                  "user_condition": {
                    "data.perfil": "gerente_rrhh"
                  }
                },
                {
                  "user_condition": {
                    "data.perfil": "gerente_general"
                  }
                },
                {
                  "user_condition": {
                    "data.perfil": "soporte"
                  }
                }
              ]
            }
          ]
        },
        {
          "$and": [
            {
              "$or": [
                {
                  "$and": [
                    {
                      "user_condition": {
                        "role": "admin"
                      }
                    },
                    {
                      "user_condition": {
                        "data.perfil": "jefe_personal"
                      }
                    }
                  ]
                },
                {
                  "user_condition": {
                    "data.acceso": true
                  }
                }
              ]
            },
            {
              "created_by": "{{user.email}}"
            }
          ]
        }
      ]
    },
    "delete": {
      "$and": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "$or": [
            {
              "user_condition": {
                "data.perfil": "gerente_rrhh"
              }
            },
            {
              "user_condition": {
                "data.perfil": "gerente_general"
              }
            },
            {
              "user_condition": {
                "data.perfil": "soporte"
              }
            }
          ]
        }
      ]
    }
  }
}